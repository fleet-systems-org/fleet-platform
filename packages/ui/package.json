{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "name": "@fleet-platform/ui",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles.css",
    "./backend/api": "./src/backend/api/apiCall.ts",
    "./backend/forms/CrudForm": "./src/backend/forms/CrudForm.tsx",
    "./backend/tables/DataTable": "./src/backend/tables/DataTable.tsx",
    "./backend/feedback/*": "./src/backend/feedback/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open --no-version-updates",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "lint:tokens": "node scripts/check-tokens.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
